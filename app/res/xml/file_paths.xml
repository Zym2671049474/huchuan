<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider 的可共享路径（P121，照小米互传的 authority 做法）。

    小米互传反编译证据（`com/miui/mishare/file/FileInfo.getContentUri`）：
        FileProvider.h(context, "com.miui.mishare", file)   → content:// URI
        Intent(ACTION_VIEW).setDataAndType(uri, mimeType).addFlags(1)
    manifest 里：
        androidx.core.content.FileProvider, authorities="com.miui.mishare"

    ★为什么必须用 FileProvider，不能直接用 file://★
    Android 7（API 24）起，把 file:// URI 放进 Intent 会抛
    FileUriExposedException。必须用 content:// + FileProvider。

    我们接收的文件落在 /sdcard/Download/互传/，
    所以这里要声明 external-path（外部存储）。
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- /sdcard/Download/互传/ -->
    <external-path name="download" path="Download/" />
    <!-- 兜底：整个外部存储（分享卡片等临时文件） -->
    <external-path name="external" path="." />
    <!-- 内部缓存（缓存的文件、缩略图） -->
    <cache-path name="cache" path="." />
    <files-path name="files" path="." />
</paths>
